<Project>
  <PropertyGroup>
    <!-- MegaDot (Mega Crit's Godot fork). The game refuses .pck files exported by a newer Godot than 4.5.1. -->
    <GodotPath Condition="'$(GodotPath)' == ''">/usr/lib/megadot/MegaDot_v4.5.1-stable_mono_linux.x86_64</GodotPath>
    <!-- Sts2Path / Sts2DataDir / ModsPath are resolved per-OS in Sts2PathDiscovery.props.
         Uncomment to override a non-default install location:
    <Sts2Path>/path/to/Slay the Spire 2</Sts2Path>
    -->
  </PropertyGroup>
</Project>
